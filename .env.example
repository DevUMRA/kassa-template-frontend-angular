# Үлгі: көшіріп, .env деп атаңыз (docker compose оны өзі оқиды). Нақты .env файлын git-ке салмаңыз.
# Frontend-те құпия жоқ: барлық мән браузерге /config.js арқылы ашық беріледі.

# Backend адресі (схемасымен, соңғы / жоқ). Бос — сол домен (/api), мысалы ng serve proxy.
API_URL=http://localhost:8000

# nginx тыңдайтын порт (контейнер ішінде). Песочницада платформа береді.
PORT=8080

# docker compose: хосттағы порт
APP_PORT=8080
